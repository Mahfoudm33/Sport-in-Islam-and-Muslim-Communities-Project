    <div class="tl-content">
      <div class="work-card" data-theme="politics" onclick="toggleCard(this)">
        <button class="expand-btn" onclick="event.stopPropagation(); toggleCard(this.parentElement)">+</button>
        <div class="work-type">Journal Article</div>
        <div class="work-title">The Muslim World in the Global Sporting Arena</div>
