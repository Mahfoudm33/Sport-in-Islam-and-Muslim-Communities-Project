    if (hint) hint.textContent = 'Click to collapse';
    const btn = card.querySelector('.expand-btn');
    if (btn) btn.textContent = '\u2212';
    setTimeout(() => card.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 120);
  } else {
    card.classList.remove('expanded');
    const hint = card.querySelector('.click-hint');
    if (hint) hint.textContent = 'Click to read summary';
    const btn = card.querySelector('.expand-btn');
    if (btn) btn.textContent = '+';
  }
}

/* FILTER */
function filterWorks(theme, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');

  const searchInput = document.getElementById('search-input');
  if (searchInput) searchInput.value = '';
  const countEl = document.getElementById('search-count');
  if (countEl) countEl.textContent = '';
  clearHighlights();

  document.querySelectorAll('.work-card').forEach(card => {
    if (theme === 'all' || card.dataset.theme === theme) {
      card.classList.remove('hidden');
    } else {
      card.classList.add('hidden');
      card.classList.remove('expanded');
    }
  });

  updateYearVisibility();
  checkNoResults();
}

/* SEARCH */
function searchWorks(query) {
  const q = query.trim().toLowerCase();
  const cards = document.querySelectorAll('.work-card');
  let visibleCount = 0;

  clearHighlights();
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  const allBtn = document.querySelector('.filter-btn[data-theme="all"]');
  if (allBtn) allBtn.classList.add('active');

  cards.forEach(card => {
    if (!q) {
      card.classList.remove('hidden');
      visibleCount++;
      return;
    }
    const searchText = (card.innerText || '').toLowerCase();
    if (searchText.includes(q)) {
      card.classList.remove('hidden');
      highlightInTitle(card, query);
      visibleCount++;
    } else {
      card.classList.add('hidden');
      card.classList.remove('expanded');
    }
  });

  const countEl = document.getElementById('search-count');
  if (countEl) {
    countEl.textContent = q ? visibleCount + ' work' + (visibleCount !== 1 ? 's' : '') + ' match "' + query + '"' : '';
  }

  updateYearVisibility();
  checkNoResults();
}

function highlightInTitle(card, query) {
  const titleEl = card.querySelector('.work-title');
  if (!titleEl) return;
  const text = titleEl.textContent || '';
  const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const regex = new RegExp('(' + escaped + ')', 'gi');
  titleEl.innerHTML = text.replace(regex, '<mark class="highlight">$1</mark>');
}

function clearHighlights() {
  document.querySelectorAll('.work-title').forEach(el => {
    if (el.querySelector('mark')) {
      el.textContent = el.textContent;
    }
  });
}

function updateYearVisibility() {
  document.querySelectorAll('.tl-year').forEach(yearEl => {
    const lineEl = yearEl.nextElementSibling;
    const contentEl = lineEl ? lineEl.nextElementSibling : null;
    if (!contentEl) return;
    const cards = contentEl.querySelectorAll('.work-card');
    const anyVisible = Array.from(cards).some(c => !c.classList.contains('hidden'));
    yearEl.style.opacity = anyVisible ? '1' : '0.2';
    if (lineEl) lineEl.style.opacity = anyVisible ? '1' : '0.2';
  });
}

function checkNoResults() {
  const anyVisible = Array.from(document.querySelectorAll('.work-card')).some(c => !c.classList.contains('hidden'));
  const msg = document.getElementById('no-results');
  if (msg) msg.classList.toggle('visible', !anyVisible);
}
</script>
